              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"acronym\": \"API\",\n  \"definition\": \"Application Programming Interface\",\n  \"description\": \"Updated description here\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/acronyms/update",
