              "path": [
                "api",
                "acronyms",
                "all-acronyms"
              ]
            },
            "description": "Retrieve all acronyms stored in the dictionary."
          },
          "response": []
        },
        {
          "name": "Add Acronym (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"acronym\": \"API\",\n  \"definition\": \"Application Programming Interface\",\n  \"description\": \"A set of rules that allows programs to talk to each other\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/acronyms/add",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "acronyms",
                "add"
              ]
            },
            "description": "Add a new acronym to the dictionary. Requires ROLE_ADMIN. Stores in both SQLite and ChromaDB via the Python AI service."
          },
          "response": []
        },
