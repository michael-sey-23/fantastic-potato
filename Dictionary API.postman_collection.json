{
  "info": {
    "_postman_id": "533350cf-d922-4c5e-bc0f-d452c99042a5",
    "name": "Dictionary API",
    "description": "Postman collection for the Dictionary API backend. Includes authentication and all acronym endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "52623924",
