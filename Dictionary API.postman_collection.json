  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    console.log('Token saved:', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login and retrieve a JWT token. The token is automatically saved to the collection variable for use in subsequent requests."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Acronyms",
      "item": [
        {
          "name": "Search Acronym",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/acronyms/search?query=IBC",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "acronyms",
                "search"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "IBC",
                  "description": "The acronym or phrase to search for"
                }
              ]
            },
            "description": "Search for an acronym definition. Routes through the Python AI service. Results are saved to search history."
          },
          "response": []
        },
        {
          "name": "Get Search History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/acronyms/history",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "acronyms",
                "history"
              ]
            },
            "description": "Get the search history for the currently authenticated user, ordered by most recent."
          },
          "response": []
        },
        {
